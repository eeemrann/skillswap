# ── Core ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/skillswap
PORT=5000
NODE_ENV=production
# Public URL of the web app (used in emails and Stripe redirects)
APP_URL=https://app.example.com
# Comma-separated origins allowed to call the API and open the realtime socket
CLIENT_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

# ── Authentication (Clerk) ───────────────────────────
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# ── Billing (Stripe) ─────────────────────────────────
# Leave unset to run without payments; pricing pages still render and checkout reports "unavailable".
STRIPE_SECRET_KEY=sk_live_replace_me
# Signing secret of the webhook endpoint https://<api>/api/billing/webhook
# (checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.*, charge.dispute.created)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Teacher payouts use Stripe Connect. Create a second webhook endpoint for "Events on Connected accounts"
# (account.updated) pointing at the same URL, and put its signing secret here.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me_too
BILLING_CURRENCY=usd
# Set to true after enabling Stripe Tax
STRIPE_AUTOMATIC_TAX=false

# ── Credit economy (see server/config/plans.js) ──────
# Free welcome credits for every new verified member. They are for learning only and can never be withdrawn.
SIGNUP_CREDITS=5
# What a credit is worth when a teacher cashes out, in cents. Keep it below the cheapest pack price per credit
# minus the platform fee so every purchase leaves the platform a margin.
PAYOUT_CENTS_PER_CREDIT=800
# Smallest withdrawal, in cents
MIN_PAYOUT_CENTS=2000
# Earnings become withdrawable this many days after a session settles (chargeback window)
PAYOUT_HOLD_DAYS=3
# Withdrawals above this amount (cents) wait for an administrator
PAYOUT_AUTO_APPROVE_CENTS=25000
# A teacher's first withdrawal is always reviewed by a person. Set to false to disable.
PAYOUT_REVIEW_FIRST=true

# ── Video sessions (WebRTC) ──────────────────────────
# STUN works for most networks. Add TURN so members behind strict firewalls/NAT can connect too.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Either a coturn "static-auth-secret" (short-lived credentials are generated per member)...
TURN_SECRET=replace-with-a-long-random-secret
# ...or a fixed account from a TURN provider:
# TURN_USERNAME=
# TURN_CREDENTIAL=
SESSION_JOIN_EARLY_MINUTES=10
SESSION_GRACE_MINUTES=15
SESSION_AUTO_SETTLE_HOURS=24
SESSION_MIN_ATTENDANCE_SECONDS=120

# ── Internal services ────────────────────────────────
MATCHING_SERVICE_URL=http://localhost:6000
NOTIFICATION_SERVICE_URL=http://localhost:7000
NOTIFICATION_SERVICE_TIMEOUT_MS=30000
NOTIFICATION_SERVICE_API_KEY=replace-with-a-long-random-shared-secret
