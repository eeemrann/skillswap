# ── Core ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/skillswap
PORT=5000
NODE_ENV=production
# Public URL of the web app (used in emails and Stripe redirects)
APP_URL=https://app.example.com
# Comma-separated origins allowed to call the API and open the realtime socket
CLIENT_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

# ── Authentication (Clerk) ───────────────────────────
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# ── Billing (Stripe) ─────────────────────────────────
# Leave unset to run without payments; pricing pages still render and checkout reports "unavailable".
STRIPE_SECRET_KEY=sk_live_replace_me
# Signing secret of the webhook endpoint https://<api>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me
BILLING_CURRENCY=usd
# Set to true after enabling Stripe Tax
STRIPE_AUTOMATIC_TAX=false
# Credits given to every new verified member
SIGNUP_CREDITS=3

# ── Video sessions (WebRTC) ──────────────────────────
# STUN works for most networks. Add TURN so members behind strict firewalls/NAT can connect too.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# Either a coturn "static-auth-secret" (short-lived credentials are generated per member)...
TURN_SECRET=replace-with-a-long-random-secret
# ...or a fixed account from a TURN provider:
# TURN_USERNAME=
# TURN_CREDENTIAL=
SESSION_JOIN_EARLY_MINUTES=10
SESSION_GRACE_MINUTES=15
SESSION_AUTO_SETTLE_HOURS=24
SESSION_MIN_ATTENDANCE_SECONDS=120

# ── Internal services ────────────────────────────────
MATCHING_SERVICE_URL=http://localhost:6000
NOTIFICATION_SERVICE_URL=http://localhost:7000
NOTIFICATION_SERVICE_TIMEOUT_MS=30000
NOTIFICATION_SERVICE_API_KEY=replace-with-a-long-random-shared-secret
